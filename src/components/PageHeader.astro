---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<div class="container-page pt-12 pb-8 sm:pt-16">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl dark:text-white">{title}</h1>
  {lead && <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">{lead}</p>}
  <slot />
</div>
