---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada" noindex>
  <div class="container-page py-24 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-2 text-4xl font-bold text-brand-900 dark:text-white">Esta página no existe</h1>
    <p class="mt-4 text-slate-700 dark:text-slate-300">
      Puede que el enlace esté roto o que la hayamos movido.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary">
        Ir al inicio
      </a>
      <a href="/blog" class="btn-secondary">
        Ver el blog
      </a>
    </div>
  </div>
</BaseLayout>
