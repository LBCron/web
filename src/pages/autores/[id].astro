---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getPosts, type Post } from "@/lib/blog";

export async function getStaticPaths() {
  const [authors, posts] = await Promise.all([getCollection("authors"), getPosts()]);
  return authors.map((author) => ({
    params: { id: author.id },
    props: { author, posts: posts.filter((p) => p.data.authors.some((a) => a.id === author.id)) },
  }));
}

const { author, posts } = Astro.props as { author: CollectionEntry<"authors">; posts: Post[] };
const { name, github, bio, url } = author.data;
---

<BaseLayout title={name} description={bio ?? `Posts de ${name} en el blog de The Agentic Stack.`}>
  <div class="container-page pt-12 pb-8 sm:pt-16">
    <div class="flex items-center gap-5">
      <img
        src={`https://github.com/${github}.png?size=160`}
        alt=""
        width="80"
        height="80"
        class="size-20 rounded-full bg-slate-200"
      />
      <div>
        <p class="eyebrow">Autor</p>
        <h1 class="text-3xl font-bold text-brand-900 dark:text-white">{name}</h1>
        <p class="mt-1 text-sm">
          <a class="link" href={`https://github.com/${github}`}>
            @{github}
          </a>
          {url && (
            <>
              {" · "}
              <a class="link" href={url}>
                {new URL(url).hostname}
              </a>
            </>
          )}
        </p>
      </div>
    </div>
    {bio && <p class="mt-6 max-w-2xl text-slate-700 dark:text-slate-300">{bio}</p>}
  </div>
  <section class="container-page" aria-labelledby="posts-autor">
    <h2 id="posts-autor" class="text-xl font-bold text-brand-900 dark:text-white">
      Posts
    </h2>
    {posts.length === 0 ? (
      <p class="mt-4 text-slate-700 dark:text-slate-300">Todavía no hay posts publicados.</p>
    ) : (
      <div class="mt-6 grid gap-6">
        {posts.map((post) => (
          <PostCard post={post} headingLevel="h3" />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
