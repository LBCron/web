---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PostCard from "@/components/PostCard.astro";
import { getPosts, type Post } from "@/lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---

<BaseLayout title={`#${tag}`} description={`Posts del blog de The Agentic Stack con la etiqueta ${tag}.`}>
  <PageHeader
    eyebrow="Etiqueta"
    title={`#${tag}`}
    lead={`${posts.length} ${posts.length === 1 ? "post" : "posts"}`}
  >
    <p class="mt-4 text-sm">
      <a class="link" href="/blog/etiquetas">
        Todas las etiquetas
      </a>
    </p>
  </PageHeader>
  <div class="container-page grid gap-6">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
